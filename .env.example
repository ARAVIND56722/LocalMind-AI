# ==============================================================================
# The Lenny Growth Assistant — Environment Configuration
# ==============================================================================

# Project & Environment
ENVIRONMENT=development
DEBUG=true

# Database Persistence (PostgreSQL with zero-install SQLite fallback)
# In Docker Compose, this connects to the postgres container:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# If left empty or unset, backend automatically defaults to local sqlite+aiosqlite:///./lenny_growth.db
DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db

# Database Credentials (for Docker PostgreSQL container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Model Provider Configuration
# Supported providers: 'ollama', 'anthropic', 'openai', 'mock'
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.2

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud Model Keys (Optional for local Ollama evaluation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
